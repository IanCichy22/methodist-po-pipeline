# Copy this file to .env and fill in your own values. .env is gitignored
# and never committed -- these are just placeholder examples.

# Gmail account the pipeline logs into via IMAP (needs an app password,
# not your regular password: https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Absolute path to the Excel tracker workbook (.xlsm) this pipeline backfills
TRACKER_PATH=C:\path\to\your\tracker.xlsm

# Only process emails from this sender address
SENDER_FILTER=sender-you-expect-po-emails-from@example.com
